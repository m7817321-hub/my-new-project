# =================================================================
# WOOJUNG SELLER - Naver SearchAd API Credentials
# =================================================================
# 네이버 검색광고(SearchAd) API 센터 (https://manage.searchad.naver.com)
# [도구] -> [API 사용 관리]에서 발급받은 키를 입력하세요.

NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=

# Autonomous V1: use distinct random values of at least 32 characters.
# Set both on the web service. Give only JOB_TOKEN to the cron service.
AUTONOMOUS_JOB_TOKEN=
AUTONOMOUS_REVIEW_TOKEN=
# Cron only: web origin (HTTPS or Railway private http://...railway.internal:PORT)
AUTONOMOUS_API_URL=
# Web: absolute DB file inside its existing persistent volume. Local --saved also requires this.
WOOJUNG_DB_PATH=
# Existing rank collector; retains previous behavior unless explicitly disabled.
RANK_SCHEDULER_ENABLED=true
