{
  "name": "woojung-seller",
  "version": "1.0.0",
  "description": "WOOJUNG SELLER - 국내 판매 자동화 및 상품화 파이프라인 MVP",
  "main": "server/index.js",
  "engines": { "node": "22.x" },
  "scripts": {
    "start": "node server/index.js",
    "start:server": "node server/index.js",
    "start:client": "npm --prefix client run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run start:server\" \"npm run start:client\"",
    "postinstall": "npm --prefix client ci",
    "build": "npm --prefix client ci && npm --prefix client run build",
    "overnight:saved": "node scripts/overnight_opportunity_analysis.js --saved",
    "overnight:cron": "node scripts/autonomous_cron.js",
    "test": "npm run test:identity && npm run test:market-model && npm run test:workflow && npm run test:margin && npm run test:health && node server/test_workflow_e2e.js && npm run test:autonomous",
    "test:autonomous": "node --test server/test_autonomous_system.js",
    "test:identity": "node server/test_identity_dedup.js",
    "test:market-model": "node server/test_market_research_model.js",
    "test:workflow": "node server/test_workflow_lineage.js",
    "test:margin": "node server/test_margin_calculator_v2.js",
    "test:health": "node server/test_health_integrations.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
